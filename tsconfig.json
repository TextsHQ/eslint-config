{
  "include": [
    "*.{mjs,ts,js}",
    "lib/**.{mjs,ts,js}",
    "*.d.ts"
  ],
  "compilerOptions": {
    "lib": [
      "es2023"
    ],
    "checkJs": true,
    "module": "node16",
    "target": "es2022",
    "strict": true,
    "esModuleInterop": true,
    "noEmit": true,
    "moduleResolution": "node16"
  }
}
